{
  "mcpServers": {
    "jiraLenovo": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://jira.tc.lenovo.com",
        "JIRA_PERSONAL_TOKEN": "${JIRA_PERSONAL_TOKEN}",
        "JIRA_PROJECTS_FILTER": "BAIO",
        "READ_ONLY_MODE": "true",
        "TOOLSETS": "jira_issues,jira_fields,jira_transitions,jira_projects,jira_agile,jira_links,jira_attachments,jira_users,jira_development,jira_metrics"
      },
      "tools": ["*"]
    }
  }
}
